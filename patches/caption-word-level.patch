+            "max_chars": {"label": "Max characters", "min": 0, "max": 200, "step": 1,
+                          "note": "0 = no limit"},
+            "max_duration": {"label": "Max seconds", "min": 0, "max": 30, "step": 0.1,
+                             "note": "0 = no limit"},
+            "min_duration": {"label": "Merge under (s)", "min": 0, "max": 5, "step": 0.05,
