+def _stamp(value) -> float:
+    """whisper.cpp's "HH:MM:SS,mmm" (also accepts '.') -> seconds."""
+    txt = str(value or "").strip().replace(",", ".")
+    parts = txt.split(":")
+    if len(parts) == 3:
+        return int(parts[0]) * 3600 + int(parts[1]) * 60 + float(parts[2])
+    if len(parts) == 2:
+        return int(parts[0]) * 60 + float(parts[1])
+    return float(txt)
