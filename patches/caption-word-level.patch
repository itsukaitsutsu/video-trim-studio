+        # otherwise it keeps the best real source its words came from.
+        if all(w.get("_est") for w in group):
+            word_src = "estimated"
+        else:
+            word_src = next((w.get("_src") for w in group if not w.get("_est")), None)
+        out.append(_cue(group, pol, word_src))
+    return out
