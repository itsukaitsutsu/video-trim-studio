+                c.get("text", ""), _num(c.get("start"), 0.0) or 0.0,
+                _num(c.get("end"), 0.0) or 0.0, lang)
+        for w in words:
+            w["_est"] = est
+            w["_src"] = c.get("word_source") or ("estimated" if est else None)
+        src.extend(words)
+    if pol["keep_segments"]:
