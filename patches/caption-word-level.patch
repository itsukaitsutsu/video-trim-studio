+                "end": _r3(_num(c.get("end"), 0.0) or 0.0),
+                "text": tidy(c.get("text", "")),
+                "words": clean_words(c.get("words")),
+                **({"word_source": c["word_source"]} if c.get("word_source") else {}),
+            })
+        return out
+    if not src:
+        return []
+    src.sort(key=lambda x: (x["s"], x["e"]))
+    out = []
