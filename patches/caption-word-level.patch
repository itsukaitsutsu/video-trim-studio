+                      "note": "0 = ignore pauses"},
+        },
+        "flags": [
+            {"id": "break_punct", "label": "Break after . ! ?"},
+            {"id": "uppercase", "label": "UPPERCASE"},
+            {"id": "strip_trailing", "label": "Drop trailing punctuation"},
+        ],
+    }
